# Perl5 setup
if [ -d ${HOME}/perl5 ]; then
  PATH="${HOME}/perl5/bin${PATH:+:${PATH}}"; export PATH;
  PERL5LIB="${HOME}/perl5/lib/perl5${PERL5LIB:+:${PERL5LIB}}"; export PERL5LIB;
  PERL_LOCAL_LIB_ROOT="${HOME}/perl5${PERL_LOCAL_LIB_ROOT:+:${PERL_LOCAL_LIB_ROOT}}"; export PERL_LOCAL_LIB_ROOT;
  PERL_MB_OPT="--install_base \"${HOME}/perl5\""; export PERL_MB_OPT;
  PERL_MM_OPT="INSTALL_BASE=${HOME}/perl5"; export PERL_MM_OPT;
fi


# Install Ruby Gems to ~/gems
GEM_HOME="$HOME/gems" ; export GEM_HOME ;
PATH="$GEM_HOME/bin:$PATH" ; export PATH ; 

# pipx installations
export PATH="$PATH:$HOME/.local/bin"

# iterm2 integration
if [ "$TERM_PROGRAM" = "iTerm.app" ] ; then
  source "${HOME}/.iterm2_shell_integration.zsh"
fi

# When emacs is installed use emacs as the editor
# Alternate method to start emacs in server mode
# as the editor of choice:
# export EDITOR='emacsclient -c -a ""'
if [ ! -z "$(which emacs)" ] ; then
   if [ "$XDG_SESSION_TYPE" = "tty" ] ; then
       export ALTERNATE_EDITOR=${EDITOR}
       export EDITOR="$(which emacs) -nw"
   elif [ "$XDG_SESSION_TYPE" = "wayland" ] ; then
       export ALTERNATE_EDITOR="${EDITOR}"
       export EDITOR="$(which emacsclient)"
   elif [ "$XDG_SESSION_TYPE" = "x11" ] ; then
       export ALTERNATE_EDITOR="${EDITOR}"
       export EDITOR="$(which emacsclient)"
   else
       export ALTERNATE_EDITOR="${EDITOR}"
       export EDITOR="$(which emacs)"
   fi
fi

# Detect if this is a Visual Studio Code remote connection
# and use Visual Studio Code as the editor if this is the
# case.
if [ ! -z "${VSCODE_IPC_HOOK_CLI}" ] ; then
  export EDITOR="code --wait"
fi

# VS Code shell integration
if [ "$TERM_PROGRAM" = "vscode" ] ; then
  source "$(code --locate-shell-integration-path zsh)"
  export EDITOR="code --wait"
fi

# The following lines were added by compinstall
zstyle :compinstall filename '/home/franz/.zshrc'

autoload -Uz compinit
compinit
# End of lines added by compinstall

# Initialize oh-my-posh
# Install the Fira Code Nerd Fonts before using oh-my-posh
# See https://ohmyposh.dev/docs/installation/fonts
if type oh-my-posh &>/dev/null ; then
  eval "$(oh-my-posh init zsh --config agnoster)"
fi

# Run fastfetch
fastfetch

