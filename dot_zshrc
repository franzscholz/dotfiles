# Lines configured by zsh-newuser-install
HISTFILE=~/.histfile
HISTSIZE=1000
SAVEHIST=1000
bindkey -e
# End of lines configured by zsh-newuser-install

# Make $PATH unique. The $path array mirrors $PATH.
typeset -aU path

# Setup oh-my-zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="agnoster"
plugins=(git)

# Include brew zsh completions
if type brew &>/dev/null; then
  FPATH=$(brew --prefix)/share/zsh-completions:$FPATH

  autoload -Uz compinit
  compinit
fi

# User configuration

# export MANPATH="/usr/local/man:$MANPATH"

# You may need to manually set your language environment
# export LANG=en_US.UTF-8

# Preferred editor for local and remote sessions
# if [[ -n $SSH_CONNECTION ]]; then
#   export EDITOR='vim'
# else
#   export EDITOR='mvim'
# fi

# Compilation flags
# export ARCHFLAGS="-arch x86_64"

# Set personal aliases, overriding those provided by oh-my-zsh libs,
# plugins, and themes. Aliases can be placed here, though oh-my-zsh
# users are encouraged to define aliases within the ZSH_CUSTOM folder.
# For a full list of active aliases, run `alias`.
#
# Example aliases
# alias zshconfig="mate ~/.zshrc"
# alias ohmyzsh="mate ~/.oh-my-zsh"

# set PATH so it includes user's private bin if it exists
if [ -d "$HOME/bin" ] ; then
  path+=("$HOME/bin")
  export PATH
fi

# set PATH so it includes user's private bin if it exists
if [ -d "$HOME/.local/bin" ] ; then
  path+=("$HOME/.local/bin")
  export PATH
fi

# Perl5 setup
if [ -d ${HOME}/perl5 ]; then
  path+=("${HOME}/perl5/bin"); export PATH;
  PERL5LIB="${HOME}/perl5/lib/perl5${PERL5LIB:+:${PERL5LIB}}"; export PERL5LIB;
  PERL_LOCAL_LIB_ROOT="${HOME}/perl5${PERL_LOCAL_LIB_ROOT:+:${PERL_LOCAL_LIB_ROOT}}"; export PERL_LOCAL_LIB_ROOT;
  PERL_MB_OPT="--install_base \"${HOME}/perl5\""; export PERL_MB_OPT;
  PERL_MM_OPT="INSTALL_BASE=${HOME}/perl5"; export PERL_MM_OPT;
fi

# QT5 configuration (homebrew)
if [[ -d /usr/local/opt/qt ]]; then
  path+=("/usr/local/opt/qt/bin")
  export PATH
  export LDFLAGS="$LDFLAGS -L/usr/local/opt/qt/lib"
  export CPPFLAGS="$CPPFLAGS -I/usr/local/opt/qt/include"
  export PKG_CONFIG_PATH="/usr/local/opt/qt/lib/pkgconfig:$PKG_CONFIG_PATH"
fi

# Install Ruby Gems to ~/gems
GEM_HOME="$HOME/gems" ; export GEM_HOME
path+=("$GEM_HOME/bin") ; export PATH 

# pipx installations
path+=("$HOME/.local/bin") ; export PATH

# iterm2 integration
if [ "$TERM_PROGRAM" = "iTerm.app" ] ; then
  source "${HOME}/.iterm2_shell_integration.zsh"
fi

# When emacs is installed use emacs as the editor
# Alternate method to start emacs in server mode
# as the editor of choice:
# export EDITOR='emacsclient -c -a ""'
if [ ! -z "$(which emacs)" ] ; then
   if [ "$XDG_SESSION_TYPE" = "tty" ] ; then
       export ALTERNATE_EDITOR=${EDITOR}
       export EDITOR="$(which emacs) -nw"
   elif [ "$XDG_SESSION_TYPE" = "wayland" ] ; then
       export ALTERNATE_EDITOR="${EDITOR}"
       export EDITOR="$(which emacsclient)"
   elif [ "$XDG_SESSION_TYPE" = "x11" ] ; then
       export ALTERNATE_EDITOR="${EDITOR}"
       export EDITOR="$(which emacsclient)"
   else
       export ALTERNATE_EDITOR="${EDITOR}"
       export EDITOR="$(which emacs)"
   fi
fi

# Detect if this is a Visual Studio Code remote connection
# and use Visual Studio Code as the editor if this is the
# case.
if [ ! -z "${VSCODE_IPC_HOOK_CLI}" ] ; then
  export EDITOR="code --wait"
fi

# VS Code shell integration
if [ "$TERM_PROGRAM" = "vscode" ] ; then
  source "$(code --locate-shell-integration-path zsh)"
  export EDITOR="code --wait"
fi

# The following lines were added by compinstall
zstyle :compinstall filename '/home/franz/.zshrc'

autoload -Uz compinit
compinit
# End of lines added by compinstall

# Initialize oh-my-posh
# Install the Fira Code Nerd Fonts before using oh-my-posh
# See https://ohmyposh.dev/docs/installation/fonts
case "$TTY" in
  (/dev/ttyv[0-9]*|/dev/tty[0-9]*)
    # Console. Use a theme without a Nerd Font.
    OMPTHEME=onehalf.minimal
    ;;
  (*)
    # Theme is using a Nerd Font
    OMPTHEME=$HOME/.franzscholz.omp.json
    ;;
esac
if type oh-my-posh &>/dev/null ; then
  eval "$(oh-my-posh init zsh --config $OMPTHEME)"
fi

# Run fastfetch
if [[ -o interactive ]]; then
  if [[ "$SHLVL" == 1 ]]; then
    if type fastfetch &>/dev/null ; then
      fastfetch
    fi
  fi
fi
